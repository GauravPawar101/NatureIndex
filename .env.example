# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Every value here is required by at least one
# part of the project; the comments say which.
#
# After editing, RESTART the dev server — Next.js only reads these at startup,
# so a change here has no effect until then. `npm run check:env` will tell you
# whether what you pasted is actually usable.
# ---------------------------------------------------------------------------

# Supabase -> Project Settings -> Data API -> "Project URL".
#
# Must be the full URL including https:// and ending in .supabase.co — not the
# project name, and not the "API Host" field next to it. A wrong value here is
# the single most common cause of a bare "Failed to fetch" in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase -> Project Settings -> API Keys.
#
# Use the *publishable* key (starts with `sb_publishable_`) if your project
# shows one. A legacy `eyJ...` anon JWT key also works.
#
# NEVER put the `sb_secret_` / service_role key here. This variable is inlined
# into the browser bundle, and a secret key bypasses all row level security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key

# Supabase -> Project Settings -> API Keys -> secret key.
# SERVER-ONLY. Never expose this to the client or commit it. It bypasses RLS
# and is used exclusively by `npm run seed`, which writes rows the anon key is
# correctly not allowed to write.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-service-role-key

# Public origin, used for absolute URLs in metadata and OG tags.
NEXT_PUBLIC_URL=http://localhost:3000

# Upstash Redis -> Details -> Connection Strings. Only the REST pair is needed
# by the web app; the Rust PageRank engine (pagerank/pageRankEngine) uses the
# TCP `redis://` URL instead.
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# --- Rust PageRank engine only (pagerank/pageRankEngine/.env) --------------
# Not read by the Next.js app. Listed here so the full set is discoverable in
# one place; see pagerank/pageRankEngine/.env.example for the engine's own
# copy.
#
# DB_URL must be Supabase's *direct* connection string (port 5432), not the
# 6543 transaction-mode pooler — the engine uses prepared statements, which
# that pooler breaks.
# DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# REDIS_URL=rediss://default:<password>@<instance>.upstash.io:6379
